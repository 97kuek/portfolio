---
import Layout from "@/layouts/Layout.astro"
import Link from "@/components/base/Link.astro"
---

<Layout title="404" noindex breadcrumbs={[{ label: "404", icon: "question" }]}>
  <prose-content>
    <h1>404</h1>
    <p>
      このページは見つかりませんでした。
      <Link href="/" underline>ホーム</Link>
      または
      <Link href="/blog" underline>ブログ</Link>
      をご覧ください。
    </p>
    <p>
      This page does not exist. Try the
      <Link href="/en" underline>home page</Link>
      or the
      <Link href="/en/blog" underline>blog</Link>
      .
    </p>
  </prose-content>
</Layout>
