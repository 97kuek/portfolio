---
import { getCollection } from "astro:content"

import CommonLayout from "@/layouts/CommonLayout.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"

const entries = await getCollection("experience")
---

<CommonLayout
  title="Experience"
  description="Education and activities to date."
  prose={false}
  breadcrumbs={[{ label: "Experience", icon: "timeline" }]}
>
  <ExperienceTimeline {entries} />
</CommonLayout>
