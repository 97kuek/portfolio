---
import type { CollectionEntry } from "astro:content"

import CoverImage from "@/components/base/CoverImage.astro"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import { getContentHref, getContentSlug } from "@/lib/content-locale"
import { CONTENT_THUMB_SIZES } from "@/lib/layout"
import { getProjectLinks } from "@/lib/projects"
import { slugify } from "@/lib/string-manipulation"
import { getUIStrings } from "@/lib/ui-strings"

import "@/styles/content-row.css"

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const { title, selected, image, code, doc, paper, url, release, skills } =
  project.data

const ui = getUIStrings(Astro.url.pathname)
const links = getProjectLinks(code, doc, paper, url, release)

// The detail page is the richer destination when it exists; otherwise send
// people straight to the thing itself, preferring the live URL over a repo.
const hasDetailPage = !!project.body?.trim()
const primaryLink = links.find((link) => link.type === "url") ?? links[0]
const titleHref = hasDetailPage
  ? getContentHref("projects", project.id, project.data)
  : primaryLink?.href
---

<article
  class="content-row"
  data-project-skills={skills.map((skill) => slugify(skill)).join(",")}
>
  <div class="content-row-thumb">
    <CoverImage
      image={image}
      seed={getContentSlug(project.id, project.data)}
      sizes={CONTENT_THUMB_SIZES}
    />
  </div>

  <div class="content-row-body">
    <div class="content-row-head">
      <h3 class="content-row-title">
        {selected && <span class="sr-only">{ui.featuredProject}</span>}
        {titleHref ? (
            <Link href={titleHref} underline>
              {title}
            </Link>
          ) : (
            title
          )}
      </h3>
      {links.length > 0 && (
          <ul class="content-row-aside">
            {links.map(({ href, icon, label }) => (
              <li>
                <Link href={href}>
                  <Icon name={icon} />
                  <span>{label}</span>
                </Link>
              </li>
            ))}
          </ul>
        )}
    </div>

    {project.data.description && (
        <p class="content-row-description">{project.data.description}</p>
      )}

    {skills.length > 0 && (
        <p class="content-row-meta">{skills.join(" · ")}</p>
      )}
  </div>
</article>
