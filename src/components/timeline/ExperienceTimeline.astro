---
import type { CollectionEntry } from "astro:content"

import Link from "@/components/base/Link.astro"
import DateRange from "@/components/projects/DateRange.astro"
import { getSiteLocale } from "@/lib/i18n"

import Timeline from "./Timeline.astro"
import TimelineDate from "./TimelineDate.astro"
import TimelineItem from "./TimelineItem.astro"

interface Props {
  entries: CollectionEntry<"experience">[]
  limit?: number
  /** Extra class on each description, for callers that want to clamp it. */
  itemClass?: string
}

const { entries, limit, itemClass } = Astro.props
const isEnglish = getSiteLocale(Astro.url.pathname) === "en"

/* Ordered by when each entry began. Sorting by end date first put a finished
   two-week internship below a degree that is still running, which reads as
   out of sequence next to its own dates. */
const sorted = [...entries].sort((a, b) => {
  const startDiff = b.data.startDate.getTime() - a.data.startDate.getTime()
  if (startDiff !== 0) return startDiff
  const endA = a.data.endDate?.getTime() ?? Infinity
  const endB = b.data.endDate?.getTime() ?? Infinity
  return endB - endA
})

const displayed = typeof limit === "number" ? sorted.slice(0, limit) : sorted

/* A two-week internship reads as a bare "Aug 2026" at month precision, which
   hides the thing the entry is about. Short, finished spans show their days. */
const TWO_MONTHS_MS = 62 * 24 * 60 * 60 * 1000
const datePrecision = (start: Date, end?: Date) =>
  end && end.getTime() - start.getTime() < TWO_MONTHS_MS ? "day" : "month"
---

<Timeline>
  {displayed.map((entry) => (
    <TimelineItem>
      <TimelineDate slot="date">
        <DateRange
          fromDate={entry.data.startDate}
          toDate={entry.data.endDate}
          locale={isEnglish ? "en-US" : "ja-JP"}
          presentLabel={isEnglish ? "Present" : "現在"}
          precision={datePrecision(entry.data.startDate, entry.data.endDate)}
        />
      </TimelineDate>
      <p class="experience-title">
        <span>{isEnglish ? entry.data.titleEn || entry.data.title : entry.data.title}</span>
        {" @ "}
        {entry.data.orgUrl ? (
          <Link href={entry.data.orgUrl} external underline>
            {isEnglish ? entry.data.orgEn || entry.data.org : entry.data.org}
          </Link>
        ) : (
          <span>{isEnglish ? entry.data.orgEn || entry.data.org : entry.data.org}</span>
        )}
        {entry.data.location && <span class="experience-location"> · {entry.data.location}</span>}
      </p>
      {entry.data.description && (
        <p class:list={["experience-description", itemClass]}>
          {isEnglish
            ? entry.data.descriptionEn || entry.data.description
            : entry.data.description}
        </p>
      )}
    </TimelineItem>
  ))}
</Timeline>

<style>
  .experience-title {
    font-size: var(--step--1);
    line-height: calc(var(--leading-offset) + 1em);
  }

  .experience-title > span:first-child {
    font-weight: var(--font-weight-medium);
  }

  .experience-location,
  .experience-description {
    color: var(--muted-foreground);
  }

  .experience-description {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: calc(var(--leading-offset) + 1em);
  }
</style>
