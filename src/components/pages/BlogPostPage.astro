---
import { render } from "astro:content"

import { SITE } from "@site-config"
import Layout from "@/layouts/Layout.astro"
import Badge from "@/components/base/Badge.astro"
import CoverImage from "@/components/base/CoverImage.astro"
import FormattedDate from "@/components/base/FormattedDate.astro"
import Icon from "@/components/base/Icon.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import PostMetadata from "@/components/blog/PostMetadata.astro"
import PostNavigation from "@/components/blog/PostNavigation.astro"
import PostRow from "@/components/blog/PostRow.astro"
import ShareActions from "@/components/blog/ShareActions.astro"
import Comments from "@/components/interactions/Comments.astro"
import Reactions from "@/components/interactions/Reactions.astro"
import TOCHeader from "@/components/toc/TOCHeader.astro"
import { PostManager } from "@/lib/blog"
import { getRelatedPosts, withMetadata } from "@/lib/blog/listing"
import { getStageVariant } from "@/lib/blog/stage"
import { taxonomyPath } from "@/lib/blog/taxonomy"
import type { Post } from "@/lib/blog/types"
import {
  getContentLocale,
  getContentSlug,
  isContentInLocale,
} from "@/lib/content-locale"
import { interactionTarget } from "@/lib/interactions"
import { COVER_SIZES, COVER_WIDTHS } from "@/lib/layout"
import { ogImagePath } from "@/lib/og"
import { sectionCrumb } from "@/lib/sections"
import { processRawHeadings } from "@/lib/toc"
import { getUIStrings } from "@/lib/ui-strings"

import "@/styles/content-row.css"

interface Props {
  post: Post
}

const { post } = Astro.props
const locale = getContentLocale(post.data)

const postManager = PostManager.getInstance()
const metadata = await postManager.getMetadata(post.id)
const { Content, headings } = await render(post)

/* Two entries is a list of the obvious; the table earns its space from three. */
const MIN_TOC_HEADINGS = 3
const tocHeadings = processRawHeadings(headings, SITE.tocMaxDepth)
const showToc = tocHeadings.length >= MIN_TOC_HEADINGS

// Navigation stays inside one language: the sibling of a Japanese post is the
// previous Japanese post, not whichever translation happens to sit next to it.
// Reactions and comments follow the writing, not the translation, so both
// language versions of a post share one thread.
const target = interactionTarget("blog", getContentSlug(post.id, post.data))

const ui = getUIStrings(locale)

const relatedPosts = await withMetadata(
  await getRelatedPosts(post, SITE.blog.relatedPostCount),
)

const localePosts = (await postManager.getMainPosts()).filter((entry) =>
  isContentInLocale(entry.data, locale),
)
const currentIndex = localePosts.findIndex((entry) => entry.id === post.id)
const newerPost = currentIndex > 0 ? localePosts[currentIndex - 1] : null
const olderPost =
  currentIndex >= 0 && currentIndex < localePosts.length - 1
    ? localePosts[currentIndex + 1]
    : null
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath("blog", post.id)}
  type="article"
  searchable
  publishedTime={post.data.createdAt}
  modifiedTime={post.data.updatedAt}
  author={metadata.authors[0]?.name}
  tags={post.data.tags}
  breadcrumbs={[sectionCrumb("blog", locale), { label: post.data.title }]}
>
  {showToc && <TOCHeader slot="toc-header" headings={tocHeadings} />}

  <article>
    <header class="post-header">
      {(post.data.stage || post.data.tags.length > 0) && (
          <div class="post-badges">
            {post.data.stage && (
                <Badge
                  variant={getStageVariant(post.data.stage)}
                  href={taxonomyPath("stage", post.data.stage, locale)}
                >
                  <Icon name={post.data.stage} />
                  {post.data.stage}
                </Badge>
              )}
            {post.data.tags.map((tag) => (
              <TaxonomyChip label={tag} href={taxonomyPath("tag", tag, locale)} />
            ))}
          </div>
        )}
      <h1 id="post-title">{post.data.title}</h1>
      {post.data.description && (
          <p class="post-description">{post.data.description}</p>
        )}
      <PostMetadata {...metadata} variant="full" class="post-meta" />
    </header>

    <div class="post-cover">
      <CoverImage
        image={post.data.image}
        seed={getContentSlug(post.id, post.data)}
        widths={COVER_WIDTHS}
        sizes={COVER_SIZES}
        loading="eager"
      />
    </div>

    <prose-content>
      <Content />
    </prose-content>

    <Reactions target={target} />

    <ShareActions
      title={post.data.title}
      url={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
      authors={metadata.authors}
      class="post-share"
    />
  </article>

  {relatedPosts.length > 0 && (
      <section class="related-posts">
        <h2>{ui.relatedPosts}</h2>
        <ul class="content-list">
          {relatedPosts.map(({ post: related, meta }) => (
            <li>
              <FormattedDate
                date={related.data.createdAt}
                class="content-list-date"
              />
              <PostRow metadata={meta} />
            </li>
          ))}
        </ul>
      </section>
    )}

  <Comments target={target} />

  <PostNavigation olderPost={olderPost} newerPost={newerPost} />
</Layout>

<style>
  .related-posts {
    display: grid;
    gap: var(--space-s);
  }

  .related-posts h2 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
  }

  article {
    display: grid;
    gap: var(--space-m);
  }

  /* Tags read as an eyebrow above the title, which leaves the byline as the
     last line before the cover instead of a third band competing with it. */
  .post-header {
    display: grid;
    gap: var(--space-3xs);
  }

  .post-header h1 {
    margin: 0;
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
    text-wrap: balance;
  }

  .post-description {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  :global(.post-meta) {
    margin-block-start: var(--space-2xs);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--border);
  }

  .post-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-3xs);
  }

  .post-cover {
    inline-size: 100%;
    aspect-ratio: var(--aspect-video);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  :global(.post-share) {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--border);
  }
</style>
