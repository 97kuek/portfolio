---
import { render } from "astro:content"

import Layout from "@/layouts/Layout.astro"
import CoverImage from "@/components/base/CoverImage.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import Badge from "@/components/base/Badge.astro"
import Icon from "@/components/base/Icon.astro"
import Comments from "@/components/interactions/Comments.astro"
import Reactions from "@/components/interactions/Reactions.astro"
import PostMetadata from "@/components/blog/PostMetadata.astro"
import PostNavigation from "@/components/blog/PostNavigation.astro"
import ShareActions from "@/components/blog/ShareActions.astro"
import { PostManager } from "@/lib/blog"
import { getStageVariant } from "@/lib/blog/stage"
import type { Post } from "@/lib/blog/types"
import {
  getContentLocale,
  getContentSlug,
  isContentInLocale,
} from "@/lib/content-locale"
import { localizedPath } from "@/lib/i18n"

interface Props {
  post: Post
}

const { post } = Astro.props
const locale = getContentLocale(post.data)
const isEnglish = locale === "en"

const postManager = PostManager.getInstance()
const metadata = await postManager.getMetadata(post.id)
const { Content } = await render(post)

// Navigation stays inside one language: the sibling of a Japanese post is the
// previous Japanese post, not whichever translation happens to sit next to it.
// Reactions and comments follow the writing, not the translation, so both
// language versions of a post share one thread.
const interactionTarget = `blog:${getContentSlug(post.id, post.data)}`

const localePosts = (await postManager.getMainPosts()).filter((entry) =>
  isContentInLocale(entry.data, locale),
)
const currentIndex = localePosts.findIndex((entry) => entry.id === post.id)
const newerPost = currentIndex > 0 ? localePosts[currentIndex - 1] : null
const olderPost =
  currentIndex >= 0 && currentIndex < localePosts.length - 1
    ? localePosts[currentIndex + 1]
    : null
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src}
  type="article"
  publishedTime={post.data.createdAt}
  modifiedTime={post.data.updatedAt}
  author={metadata.authors[0]?.name}
  tags={post.data.tags}
  breadcrumbs={[
    {
      label: isEnglish ? "Blog" : "ブログ",
      href: localizedPath("/blog", locale),
      icon: "blog",
    },
    { label: post.data.title },
  ]}
>
  <article>
    <header class="post-header">
      {(post.data.stage || post.data.tags.length > 0) && (
          <div class="post-badges">
            {post.data.stage && (
                <Badge variant={getStageVariant(post.data.stage)}>
                  <Icon name={post.data.stage} />
                  {post.data.stage}
                </Badge>
              )}
            {post.data.tags.map((tag) => (
              <TaxonomyChip label={tag} static />
            ))}
          </div>
        )}
      <h1 id="post-title">{post.data.title}</h1>
      {post.data.description && (
          <p class="post-description">{post.data.description}</p>
        )}
      <PostMetadata {...metadata} variant="full" class="post-meta" />
    </header>

    <div class="post-cover">
      <CoverImage
        image={post.data.image}
        seed={getContentSlug(post.id, post.data)}
        widths={[640, 960, 1280]}
        sizes="(max-width: 48rem) 100vw, 48rem"
        loading="eager"
      />
    </div>

    <prose-content>
      <Content />
    </prose-content>

    <Reactions target={interactionTarget} />

    <ShareActions
      title={post.data.title}
      url={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
      authors={metadata.authors}
      class="post-share"
    />
  </article>

  <Comments target={interactionTarget} />

  <PostNavigation prevPost={olderPost} nextPost={newerPost} />
</Layout>

<style>
  article {
    display: grid;
    gap: var(--space-m);
  }

  /* Tags read as an eyebrow above the title, which leaves the byline as the
     last line before the cover instead of a third band competing with it. */
  .post-header {
    display: grid;
    gap: var(--space-3xs);
  }

  .post-header h1 {
    margin: 0;
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
    text-wrap: balance;
  }

  .post-description {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  :global(.post-meta) {
    margin-block-start: var(--space-2xs);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--border);
  }

  .post-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-3xs);
  }

  .post-cover {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  :global(.post-share) {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--border);
  }
</style>
