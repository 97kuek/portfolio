---
import { getCollection } from "astro:content"

import Layout from "@/layouts/Layout.astro"
import Section from "@/components/layout/Section.astro"
import FormattedDate from "@/components/base/FormattedDate.astro"
import PostRow from "@/components/blog/PostRow.astro"
import Profile from "@/components/profile/Profile.astro"
import DateRange from "@/components/projects/DateRange.astro"
import ProjectRow from "@/components/projects/ProjectRow.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import { PROFILE, SITE, getSiteDescription } from "@site-config"
import { getPostsInLocale, withMetadata } from "@/lib/blog/listing"
import { isContentInLocale } from "@/lib/content-locale"
import { getSiteLocale } from "@/lib/i18n"
import { sectionLabel, sectionPath } from "@/lib/sections"
import { getProjects } from "@/lib/projects"

import "@/styles/content-row.css"

const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"
const experience = await getCollection("experience")

const projects = (
  await getProjects((project) => isContentInLocale(project.data, locale))
).slice(0, SITE.home.projectCount)

const latestPosts = await withMetadata(
  (await getPostsInLocale(locale)).slice(0, SITE.home.postCount),
)
---

<Layout
  title={isEnglish ? "Home" : "ホーム"}
  type="profile"
  schemaType="ProfilePage"
  description={getSiteDescription(locale)}
>
  <Profile
    profile={PROFILE}
    continueHref={projects.length > 0 ? "#projects" : undefined}
  />

  {projects.length > 0 && (
      <Section
        id="projects"
        title={sectionLabel("projects", locale)}
        moreLink={sectionPath("projects", locale)}
        moreText={isEnglish ? "All projects →" : "すべて見る →"}
      >
        <ul class="content-list">
          {projects.map((project) => (
            <li>
              <DateRange
                fromDate={project.data.fromDate}
                toDate={project.data.toDate}
                locale={isEnglish ? "en-US" : "ja-JP"}
                presentLabel={isEnglish ? "Present" : "現在"}
                showIcon
                class="content-list-date"
              />
              <ProjectRow project={project} />
            </li>
          ))}
        </ul>
      </Section>
    )}

  <Section
    title={sectionLabel("experience", locale)}
    moreLink={sectionPath("experience", locale)}
    moreText={isEnglish ? "View details →" : "詳しく見る →"}
  >
    <ExperienceTimeline
      entries={experience}
      limit={SITE.home.careerHighlightCount}
    />
  </Section>

  {latestPosts.length > 0 && (
      <Section
        title={isEnglish ? "Latest posts" : "最新の記事"}
        moreLink={sectionPath("blog", locale)}
        moreText={isEnglish ? "All posts →" : "すべて見る →"}
      >
        <ul class="content-list">
          {latestPosts.map(({ post, meta }) => (
            <li>
              <FormattedDate
                date={post.data.createdAt}
                class="content-list-date"
              />
              <PostRow metadata={meta} />
            </li>
          ))}
        </ul>
      </Section>
    )}
</Layout>
