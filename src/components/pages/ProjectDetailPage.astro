---
import { render } from "astro:content"

import CommonLayout from "@/layouts/CommonLayout.astro"
import CoverImage from "@/components/base/CoverImage.astro"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import Comments from "@/components/interactions/Comments.astro"
import Reactions from "@/components/interactions/Reactions.astro"
import DateRange from "@/components/projects/DateRange.astro"
import ProjectNavigation from "@/components/projects/ProjectNavigation.astro"
import {
  getContentLocale,
  getContentSlug,
  isContentInLocale,
} from "@/lib/content-locale"
import { sectionCrumb } from "@/lib/sections"
import { interactionTarget } from "@/lib/interactions"
import { COVER_SIZES, COVER_WIDTHS } from "@/lib/layout"
import {
  getProjectLinks,
  getProjectNavigation,
  type Project,
} from "@/lib/projects"

interface Props {
  project: Project
}

const { project } = Astro.props
const { title, description, image, fromDate, toDate, skills } = project.data

const locale = getContentLocale(project.data)
const isEnglish = locale === "en"

const { Content } = await render(project)
const links = getProjectLinks(
  project.data.code,
  project.data.doc,
  project.data.paper,
  project.data.url,
  project.data.release,
)
const target = interactionTarget(
  "projects",
  getContentSlug(project.id, project.data),
)

const { prev, next } = await getProjectNavigation(project.id, (candidate) =>
  isContentInLocale(candidate.data, locale),
)
---

<CommonLayout
  title={title}
  description={description}
  prose={false}
  type="article"
  image={image?.src}
  breadcrumbs={[sectionCrumb("projects", locale), { label: title }]}
>
  <section class="project-meta">
    <p class="project-facts">
      <DateRange
        fromDate={fromDate}
        toDate={toDate}
        locale={isEnglish ? "en-US" : "ja-JP"}
        presentLabel={isEnglish ? "Present" : "現在"}
        showIcon
      />
    </p>
    {links.length > 0 && (
        <ul class="project-links">
          {links.map(({ href, icon, label }) => (
            <li>
              <Link href={href} class="project-link">
                <Icon name={icon} />
                <span>{label}</span>
              </Link>
            </li>
          ))}
        </ul>
      )}
  </section>

  <div class="project-hero">
    <CoverImage
      image={image}
      seed={getContentSlug(project.id, project.data)}
      widths={COVER_WIDTHS}
      sizes={COVER_SIZES}
      loading="eager"
    />
  </div>

  <prose-content>
    <Content />
  </prose-content>

  {skills.length > 0 && (
      <section class="project-skills">
        <h2>{isEnglish ? "Stack" : "使用技術"}</h2>
        <p>{skills.join(" · ")}</p>
      </section>
    )}

  <Reactions target={target} />

  <Comments target={target} />

  <ProjectNavigation prev={prev} next={next} />
</CommonLayout>

<style>
  .project-hero {
    inline-size: 100%;
    aspect-ratio: var(--aspect-video);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  /* The facts sit on their own line and the links on the next, so a project
     with five links never pushes the dates out of view on a narrow screen. */
  .project-meta {
    display: grid;
    gap: var(--space-2xs);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .project-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin: 0;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.project-link) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-block-size: var(--control-size-compact);
    padding-inline: var(--space-2xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--muted-foreground);
  }

  :global(.project-link:is(:hover, :focus-visible)) {
    border-color: var(--accent);
    color: var(--foreground);
  }

  .project-skills h2 {
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    margin-block-end: var(--space-3xs);
  }

  .project-skills p {
    margin: 0;
    color: var(--muted-foreground);
  }
</style>
