---
import CommonLayout from "@/layouts/CommonLayout.astro"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
import { getProfileLinkHref } from "@/components/profile/helper"
import DateRange from "@/components/projects/DateRange.astro"
import ProjectRow from "@/components/projects/ProjectRow.astro"
import { isContentInLocale } from "@/lib/content-locale"
import { getSiteLocale } from "@/lib/i18n"
import { sectionCrumb, sectionLabel } from "@/lib/sections"
import { getProjects } from "@/lib/projects"

import "@/styles/content-row.css"

const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"

const projects = await getProjects((project) =>
  isContentInLocale(project.data, locale),
)
---

<CommonLayout
  title={sectionLabel("projects", locale)}
  description={isEnglish
    ? "Projects in AI, machine learning, and software engineering."
    : "AI・機械学習・ソフトウェア開発のプロジェクトを掲載しています。"}
  prose={false}
  breadcrumbs={[sectionCrumb("projects", locale, { current: true })]}
>
  {projects.length > 0 ? (
      <ul class="content-list">
        {projects.map((project) => (
          <li>
            <DateRange
              fromDate={project.data.fromDate}
              toDate={project.data.toDate}
              locale={isEnglish ? "en-US" : "ja-JP"}
              presentLabel={isEnglish ? "Present" : "現在"}
              showIcon
              class="content-list-date"
            />
            <ProjectRow project={project} />
          </li>
        ))}
      </ul>
    ) : (
      <section class="project-empty">
        <Icon name="folder-open" size="2rem" />
        <h2>{isEnglish ? "Work in progress" : "準備中です"}</h2>
        <p>
          {isEnglish
            ? "I am organizing the projects I can share publicly. In the meantime, visit my GitHub profile."
            : "公開できるプロジェクトを整理しています。最新の活動はGitHubからご覧いただけます。"}
        </p>
        <Button href={getProfileLinkHref("github")} external variant="outline">
          <Icon name="mingcute:github-line" />
          GitHub
        </Button>
      </section>
    )}
</CommonLayout>

<style>
  .project-empty {
    display: flex;
    min-block-size: 18rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    padding: var(--space-l);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--muted) 35%, transparent);
    text-align: center;
  }

  .project-empty h2,
  .project-empty p {
    margin: 0;
  }

  .project-empty p {
    max-inline-size: 38rem;
    color: var(--muted-foreground);
  }
</style>
