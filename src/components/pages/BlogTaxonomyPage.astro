---
import CommonLayout from "@/layouts/CommonLayout.astro"
import FormattedDate from "@/components/base/FormattedDate.astro"
import PostRow from "@/components/blog/PostRow.astro"
import { getStageConfig, getStageLabel } from "@/lib/blog/stage"
import type { TaxonomyKind } from "@/lib/blog/taxonomy"
import { withMetadata } from "@/lib/blog/listing"
import { getPostsByTaxonomy } from "@/lib/blog/taxonomy"
import { getSiteLocale } from "@/lib/i18n"
import { sectionCrumb } from "@/lib/sections"

import "@/styles/content-row.css"

interface Props {
  kind: TaxonomyKind
  value: string
}

const { kind, value } = Astro.props
const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"

const entries = await withMetadata(
  await getPostsByTaxonomy(locale, kind, value),
)

const isTag = kind === "tag"
const heading = isTag ? `#${value}` : getStageLabel(value, locale)
const stageDescriptionsJa: Record<string, string> = {
  seedling:
    "考え始めたアイデアやメモ。まだ整理の途中ですが、これから掘り下げたい考えを記録しています。",
  budding: "アイデアを掘り下げ、構成や説明を整えている記事です。",
  evergreen: "時間をかけて見直し、内容を整理した記事です。",
}
const stageDescription = isTag
  ? undefined
  : isEnglish
    ? getStageConfig(value)?.description
    : stageDescriptionsJa[value]
const description =
  stageDescription ??
  (isEnglish
    ? `Posts tagged ${value}.`
    : `${value} タグの付いた記事の一覧です。`)
---

<CommonLayout
  title={heading}
  description={description}
  prose={false}
  breadcrumbs={[
    sectionCrumb("blog", locale),
    ...(isTag ? [sectionCrumb("tags", locale)] : []),
    { label: heading },
  ]}
>
  <ul class="content-list">
    {entries.map(({ post, meta }) => (
      <li>
        <FormattedDate date={post.data.createdAt} class="content-list-date" />
        <PostRow metadata={meta} />
      </li>
    ))}
  </ul>
</CommonLayout>
