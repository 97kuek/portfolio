---
import CommonLayout from "@/layouts/CommonLayout.astro"
import Icon from "@/components/base/Icon.astro"
import FormattedDate from "@/components/base/FormattedDate.astro"
import PostRow from "@/components/blog/PostRow.astro"
import { SITE } from "@site-config"
import Pagination from "@/components/base/Pagination.astro"
import { getPostsInLocale, withMetadata } from "@/lib/blog/listing"
import { getSiteLocale } from "@/lib/i18n"
import { sectionCrumb, sectionLabel, sectionPath } from "@/lib/sections"

import "@/styles/content-row.css"

const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"

interface Props {
  /** One-based; page one is the section itself, later pages live under /page. */
  page?: number
}

const { page = 1 } = Astro.props

const posts = await getPostsInLocale(locale)
const perPage = SITE.blog.postsPerPage
const totalPages = Math.max(1, Math.ceil(posts.length / perPage))
const entries = await withMetadata(
  posts.slice((page - 1) * perPage, page * perPage),
)
---

<CommonLayout
  title={sectionLabel("blog", locale)}
  description={isEnglish
    ? "Notes on AI engineering, learning, and building software."
    : "AIエンジニアリング、学び、ソフトウェア開発について記録します。"}
  prose={false}
  breadcrumbs={[sectionCrumb("blog", locale, { current: true })]}
>
  {entries.length > 0 ? (
      <ul class="content-list">
        {entries.map(({ post, meta }) => (
          <li>
            <FormattedDate
              date={post.data.createdAt}
              class="content-list-date"
            />
            <PostRow metadata={meta} />
          </li>
        ))}
      </ul>
    ) : (
      <section class="blog-empty">
        <Icon name="blog" size="2rem" />
        <h2>
          {isEnglish ? "First post coming soon" : "最初の記事を準備しています"}
        </h2>
        <p>
          {isEnglish
            ? "I will share what I learn and build here."
            : "学んだことや開発したものを、ここで発信していきます。"}
        </p>
      </section>
    )}
  {totalPages > 1 && (
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl={sectionPath("blog", locale)}
        pageBaseUrl={`${sectionPath("blog", locale)}/page`}
      />
    )}
</CommonLayout>

<style>
  .blog-empty {
    display: flex;
    min-block-size: 18rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    padding: var(--space-l);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .blog-empty h2,
  .blog-empty p {
    margin: 0;
  }

  .blog-empty p {
    color: var(--muted-foreground);
  }
</style>
