---
import { getCollection } from "astro:content"

import CommonLayout from "@/layouts/CommonLayout.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import { getSiteLocale } from "@/lib/i18n"

const isEnglish = getSiteLocale(Astro.url.pathname) === "en"
const entries = await getCollection("experience")
---

<CommonLayout
  title={isEnglish ? "Experience" : "経歴"}
  description={isEnglish
    ? "Education and activities to date."
    : "学歴とこれまでの活動を紹介します。"}
  prose={false}
  breadcrumbs={[{
    label: isEnglish ? "Experience" : "経歴",
    icon: "timeline",
  }]}
>
  <ExperienceTimeline {entries} />
</CommonLayout>
