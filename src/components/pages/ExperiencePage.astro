---
import { getCollection } from "astro:content"

import CommonLayout from "@/layouts/CommonLayout.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import { getSiteLocale } from "@/lib/i18n"
import { sectionCrumb, sectionLabel } from "@/lib/sections"

const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"
const entries = await getCollection("experience")
---

<CommonLayout
  title={sectionLabel("experience", locale)}
  description={isEnglish
    ? "Education and activities to date."
    : "学歴とこれまでの活動を紹介します。"}
  prose={false}
  searchable
  breadcrumbs={[sectionCrumb("experience", locale, { current: true })]}
>
  <ExperienceTimeline {entries} />
</CommonLayout>
