---
import CommonLayout from "@/layouts/CommonLayout.astro"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
import { getSiteLocale } from "@/lib/i18n"
import { sectionCrumb } from "@/lib/sections"
import { getUIStrings } from "@/lib/ui-strings"

const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"
const ui = getUIStrings(locale)
---

<CommonLayout
  title={ui.search}
  description={isEnglish
    ? "Search the posts, projects and experience on this site."
    : "このサイトの記事・プロジェクト・経歴を検索できます。"}
  prose={false}
  noindex
  breadcrumbs={[sectionCrumb("search", locale, { current: true })]}
>
  <site-search
    data-empty={ui.searchEmpty}
    data-error={import.meta.env.DEV ? ui.searchUnavailable : ui.searchFailed}
    data-searching={ui.searching}
    data-result-count={ui.searchResultCount}
    class="search"
  >
    <form class="search-form" role="search" data-form>
      <label class="sr-only" for="search-input">{ui.search}</label>
      <span class="search-icon" aria-hidden="true">
        <Icon name="search" />
      </span>
      <input
        id="search-input"
        type="search"
        name="q"
        autocomplete="off"
        placeholder={ui.searchPlaceholder}
        data-input
      >
    </form>

    <p class="search-status" role="status" aria-live="polite" data-status></p>
    {!import.meta.env.DEV && (
        <div hidden data-recovery>
          <Button variant="outline" data-reload>{ui.searchReload}</Button>
        </div>
      )}
    <ol class="search-results" data-results></ol>
  </site-search>
</CommonLayout>

<style>
  .search {
    display: grid;
    gap: var(--space-s);
  }

  .search-form {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    inset-inline-start: var(--space-2xs);
    display: inline-flex;
    color: var(--muted-foreground);
    pointer-events: none;
  }

  .search-form input {
    inline-size: 100%;
    min-block-size: var(--control-size);
    padding-inline: calc(var(--space-2xs) * 2 + 1em) var(--space-2xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: var(--step-0);
  }

  .search-form input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .search-status {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .search-results {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<style is:global>
  .search-result {
    display: grid;
    gap: var(--space-3xs);
    padding-block-end: var(--space-s);
    border-block-end: 1px solid var(--border);
  }

  .search-result:last-child {
    padding-block-end: 0;
    border-block-end: none;
  }

  .search-result h2 {
    margin: 0;
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
  }

  .search-result p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .search-result mark {
    background: color-mix(in oklab, var(--accent) 22%, transparent);
    color: inherit;
  }
</style>

<script>
  interface PagefindResultData {
    url: string
    meta: { title?: string }
    excerpt: string
  }

  interface PagefindResult {
    data: () => Promise<PagefindResultData>
  }

  interface Pagefind {
    search: (query: string) => Promise<{ results: PagefindResult[] }>
  }

  /* Built after the site, so it has no module for TypeScript to resolve and
     no file at all during `astro dev`. A variable specifier keeps both the
     type checker and Vite's import analysis out of it. */
  const PAGEFIND_URL = "/pagefind/pagefind.js"
  const DEBOUNCE_MS = 180
  const MAX_RESULTS = 20

  class SiteSearch extends HTMLElement {
    private pagefind: Pagefind | null = null
    private loading: Promise<Pagefind | null> | null = null
    private input: HTMLInputElement | null = null
    private results: HTMLOListElement | null = null
    private status: HTMLElement | null = null
    private recovery: HTMLElement | null = null
    private timer: number | undefined
    private requestId = 0

    connectedCallback() {
      this.input = this.querySelector("[data-input]")
      this.results = this.querySelector("[data-results]")
      this.status = this.querySelector("[data-status]")
      this.recovery = this.querySelector("[data-recovery]")
      if (!this.input) return

      this.input.addEventListener("input", () => {
        this.updateLanguageSwitch(this.input!.value)
        this.requestId++
        window.clearTimeout(this.timer)
        this.timer = window.setTimeout(
          () => void this.run(this.input!.value),
          DEBOUNCE_MS,
        )
      })
      this.querySelector("[data-form]")?.addEventListener("submit", (event) => {
        event.preventDefault()
        window.clearTimeout(this.timer)
        void this.run(this.input!.value)
      })
      this.querySelector("[data-reload]")?.addEventListener("click", () => {
        window.clearTimeout(this.timer)
        // Failed module imports stay cached until the document reloads.
        // Keep even edits made before the input debounce has run.
        this.updateQuery(this.input!.value)
        location.reload()
      })

      // A query in the URL makes a search shareable and survives a reload.
      const initial = new URLSearchParams(location.search).get("q")
      if (initial) {
        this.input.value = initial
        void this.run(initial)
      }
    }

    disconnectedCallback() {
      this.requestId++
      window.clearTimeout(this.timer)
    }

    private updateLanguageSwitch(rawQuery: string) {
      const link = document.querySelector<HTMLAnchorElement>(
        "a[data-language-switch]",
      )
      if (!link) return
      const url = new URL(link.href)
      const query = rawQuery.trim()
      if (query) url.searchParams.set("q", query)
      else url.searchParams.delete("q")
      link.href = url.href
    }

    /* The index is built after the site, so it does not exist during `astro
       dev`; the page stays usable and says so. */
    private async load(): Promise<Pagefind | null> {
      if (this.pagefind) return this.pagefind
      if (!this.loading) {
        this.loading = import(/* @vite-ignore */ PAGEFIND_URL)
          .then((module: Pagefind) => {
            // Pagefind detects the document language on first use. Language
            // links reload the document so a cached index cannot cross locales.
            this.pagefind = module
            return module
          })
          .catch(() => {
            this.loading = null
            return null
          })
      }
      return this.loading
    }

    private setStatus(message: string) {
      if (this.status) this.status.textContent = message
    }

    private showError() {
      this.setStatus(this.dataset.error ?? "")
      if (this.recovery) this.recovery.hidden = false
    }

    private updateQuery(rawQuery: string) {
      const query = rawQuery.trim()
      this.updateLanguageSwitch(query)
      const url = new URL(location.href)
      if (query) url.searchParams.set("q", query)
      else url.searchParams.delete("q")
      // Astro uses this state to restore the page on Back and Forward.
      history.replaceState(history.state, "", url)
      return query
    }

    private async run(rawQuery: string) {
      const requestId = ++this.requestId
      const query = this.updateQuery(rawQuery)
      const isCurrent = () => this.isConnected && requestId === this.requestId
      if (this.recovery) this.recovery.hidden = true

      if (!this.results) return
      this.results.replaceChildren()
      if (!query) {
        this.setStatus("")
        return
      }

      /* The index is a wasm download on the first query, which is long enough
         to look broken without a word. */
      this.setStatus(this.dataset.searching ?? "")

      try {
        const pagefind = await this.load()
        if (!isCurrent()) return
        if (!pagefind) {
          this.showError()
          return
        }

        const { results } = await pagefind.search(query)
        const found = await Promise.all(
          results.slice(0, MAX_RESULTS).map((result) => result.data()),
        )

        if (!isCurrent()) return
        this.results.replaceChildren()
        if (found.length === 0) {
          this.setStatus(this.dataset.empty ?? "")
          return
        }

        this.setStatus(
          (this.dataset.resultCount ?? "{count}").replace(
            "{count}",
            String(results.length),
          ),
        )

        for (const entry of found) {
          const item = document.createElement("li")
          item.className = "search-result"

          const heading = document.createElement("h2")
          const link = document.createElement("a")
          link.href = entry.url
          link.textContent = entry.meta.title ?? entry.url
          heading.append(link)

          // Pagefind's excerpt carries <mark> around the matched words.
          const excerpt = document.createElement("p")
          excerpt.innerHTML = entry.excerpt

          item.append(heading, excerpt)
          this.results.append(item)
        }
      } catch {
        if (isCurrent()) this.showError()
      }
    }
  }

  if (!customElements.get("site-search")) {
    customElements.define("site-search", SiteSearch)
  }
</script>
