---
import Icon from "@/components/base/Icon.astro"
import { getSiteLocale, localizedPath } from "@/lib/i18n"
import { getUIStrings } from "@/lib/ui-strings"

export interface BreadcrumbItem {
  href?: string
  label: string
  icon?: string
}

interface Props {
  items: BreadcrumbItem[]
  class?: string
}

const { items, class: className } = Astro.props
const locale = getSiteLocale(Astro.url.pathname)
const ui = getUIStrings(locale)

// Add current page indicator to last item
const breadcrumbItems = items.map((item, index) => ({
  ...item,
  isCurrent: index === items.length - 1,
}))

const linkClasses = "breadcrumb-link stretched-link"
const currentClasses = "breadcrumb-current"
---

<nav aria-label={ui.breadcrumbNav} class={className}>
  <ol class="breadcrumb-list">
    <li class="breadcrumb-item">
      <a
        href={localizedPath("/", locale)}
        class={linkClasses}
        aria-label={ui.navigateHome}
        title={ui.goHome}
      >
        <Icon name="home" size="1.25rem" aria-hidden="true" />
        <span class="sr-only">{ui.home}</span>
      </a>
    </li>

    {breadcrumbItems.map((item) => (
        <>
          <li role="presentation" aria-hidden="true">
            <Icon name="chevron-right" aria-hidden="true" />
          </li>
          <li class="breadcrumb-item">
            {item.isCurrent ? (
              <span aria-current="page" class={currentClasses} title={item.label}>
                {item.icon && (
                  <Icon name={item.icon} size="1.25rem" class="breadcrumb-icon" aria-hidden="true" />
                )}
                <span class="breadcrumb-label">{item.label}</span>
              </span>
            ) : (
              <a
                href={item.href}
                class={linkClasses}
              >
                {item.icon && (
                  <Icon name={item.icon} size="1.25rem" class="breadcrumb-icon" aria-hidden="true" />
                )}
                <span class="breadcrumb-label">{item.label}</span>
              </a>
            )}
          </li>
        </>
      ))}
  </ol>
</nav>

<style>
  /* A post title is the last crumb, and a long one has nowhere to wrap: the
     label is `nowrap` so that it ellipses instead. Nothing between it and the
     page was allowed to shrink, though — a flex item refuses to go below its
     content by default — so the trail grew past the viewport and took the
     page with it. Every box down to the label opts out of that floor, which
     is what lets the ellipsis do its job. */
  nav {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs) var(--space-2xs);
    padding: 0;
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    list-style: none;

    @media (width >= 40rem) {
      gap: var(--space-2xs);
    }
  }

  .breadcrumb-item,
  .breadcrumb-link,
  .breadcrumb-current {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .breadcrumb-link,
  .breadcrumb-current {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .breadcrumb-item {
    position: relative;
    min-inline-size: 0;
  }

  .breadcrumb-link {
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .breadcrumb-link:hover {
    color: var(--foreground);
  }

  .breadcrumb-link:focus {
    outline: none;
  }

  .breadcrumb-link:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--ring) 50%, transparent);
    outline-offset: 2px;
  }

  .breadcrumb-current {
    color: var(--foreground);
    font-weight: var(--font-weight-normal);
  }

  :global(.breadcrumb-icon) {
    margin-inline-end: var(--space-3xs);
  }

  .breadcrumb-label {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1;
  }
</style>
