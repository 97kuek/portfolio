---
import { NAV_LINKS } from "@site-config"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import MobileMenu from "@/components/layout/MobileMenu.astro"
import ThemeToggle from "@/components/layout/ThemeToggle.astro"
import ProfileLinks from "@/components/profile/ProfileLinks.astro"
import {
  getDisplayName,
  getProfileLinkPlacement,
} from "@/components/profile/helper"
import { alternateLanguagePath, getSiteLocale, localizedPath } from "@/lib/i18n"
import { navLabel, sectionLabel, sectionPath } from "@/lib/sections"
import { getUIStrings } from "@/lib/ui-strings"

const headerLinks = getProfileLinkPlacement("header")
const hasHeaderLinks = headerLinks.length > 0
const locale = getSiteLocale(Astro.url.pathname)
const homeHref = localizedPath("/", locale)
const languageHref = alternateLanguagePath(Astro.url.pathname)
const ui = getUIStrings(locale)
const displayName = getDisplayName(locale)
---

<header class="site-header">
  <div class="site-brand">
    {hasHeaderLinks ? (
        <Button
          href={homeHref}
          variant="ghost"
          size="square"
          class="site-home"
          title={displayName}
          aria-label={displayName}
          transition:persist
        >
          <Icon name="home" size="1.5rem" />
        </Button>
      ) : (
        <Link href={homeHref} class="site-title" transition:persist>
          <span>{displayName}</span>
        </Link>
      )}
    {hasHeaderLinks && (
        <ProfileLinks as="icon" keys={headerLinks} class="header-links" />
      )}
  </div>
  <div class="site-actions">
    <nav class="desktop-nav" aria-label={ui.siteNav}>
      {NAV_LINKS.map((item) => {
        const isActive =
          Astro.url.pathname === localizedPath(item.href, locale) ||
          Astro.url.pathname.startsWith(`${localizedPath(item.href, locale)}/`)
        return (
          <Link
            href={localizedPath(item.href, locale)}
            class:list={["nav-link", isActive && "nav-active"]}
          >
            {navLabel(item.href, item.label, locale)}
          </Link>
        )
      })}
    </nav>
    <Button
      href={sectionPath("search", locale)}
      variant="ghost"
      size="square"
      title={sectionLabel("search", locale)}
      aria-label={sectionLabel("search", locale)}
    >
      <Icon name="search" size="1.25rem" />
    </Button>
    <Link
      href={languageHref}
      class="language-switch"
      data-language-switch={locale === "en" ? "ja" : "en"}
      aria-label={locale === "en" ? "日本語に切り替える" : "Switch to English"}
    >
      {locale === "en" ? "JA" : "EN"}
    </Link>
    <MobileMenu locale={locale} transition:persist />
    <div class="desktop-theme">
      <ThemeToggle transition:persist />
    </div>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);

    /* The controls already carry their own --control-size height, so the bar
       only needs enough padding to keep them off the sticky bar's edge. */
    min-height: var(--control-size);
    padding-block: var(--space-3xs);
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    min-inline-size: 0;
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    min-inline-size: 0;
    overflow: hidden;
    color: var(--foreground);
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  /* The square centers a 1.5rem glyph, which would otherwise sit inset from
     the content edge that the title's text used to meet. Pull it back by that
     internal gap so the icon optically aligns with the prose below. */
  .site-home {
    flex-shrink: 0;
    margin-inline-start: calc((var(--control-size) - 1.5rem) / -2);
  }

  /* Theme switching moves into the menu dropdown on small screens, so the
     standalone toggle would be a duplicate control there. */
  .desktop-theme {
    display: none;

    @media (width >= 40rem) {
      display: flex;
    }
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--control-size);
    min-block-size: var(--control-size);
    border-radius: var(--radius-md);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .language-switch:hover,
  .language-switch:focus-visible {
    background: var(--interactive-background);
    color: var(--interactive-foreground);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--step--1);

    @media (width >= 40rem) {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2xs);
    color: var(--muted-foreground);
    text-decoration: none;
    text-transform: capitalize;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-active {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  .nav-active::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    inline-size: 4px;
    block-size: 4px;
    border-radius: var(--radius-full);
    background: var(--primary);
    opacity: 0.9;
    transition:
      opacity var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .nav-active:hover::after {
    opacity: 1;
    transform: translateX(-50%) scale(1.25);
  }
</style>
