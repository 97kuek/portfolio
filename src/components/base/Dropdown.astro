---
export interface Props {
  class?: string
  align?: "start" | "end" | "center"
  sideOffset?: number
  id?: string
  open?: boolean
}

const {
  class: className,
  align = "start",
  sideOffset = 4,
  id = `dropdown-${Math.random().toString(36).substring(2, 9)}`,
  open = false,
  ...rest
} = Astro.props
---

<dropdown-menu
  data-dropdown-root
  data-state={open ? "open" : "closed"}
  style={`--dropdown-offset:${sideOffset}px`}
>
  <slot name="trigger" />
  <div
    id={id}
    data-dropdown-content
    data-align={align}
    class={className}
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
    {...rest}
  >
    <slot />
  </div>
</dropdown-menu>

<script>
  class DropdownMenu extends HTMLElement {
    private trigger: HTMLElement | null = null
    private content: HTMLElement | null = null
    private events: AbortController | null = null
    private isOpen = false

    connectedCallback() {
      this.events?.abort()
      this.events = new AbortController()
      const { signal } = this.events
      this.trigger = this.querySelector("[data-dropdown-trigger]")
      this.content = this.querySelector("[data-dropdown-content]")
      if (!this.trigger || !this.content) return

      this.trigger.id ||= `${this.content.id}-trigger`
      this.trigger.setAttribute("aria-haspopup", "menu")
      this.trigger.setAttribute("aria-controls", this.content.id)
      this.content.setAttribute("aria-labelledby", this.trigger.id)
      for (const item of this.items()) {
        if (!item.hasAttribute("role")) item.setAttribute("role", "menuitem")
        item.tabIndex = -1
      }
      this.isOpen = this.dataset.state === "open"
      this.trigger.setAttribute("aria-expanded", String(this.isOpen))
      this.trigger.addEventListener("click", this.handleTriggerClick, {
        signal,
      })
      this.content.addEventListener("click", this.handleContentClick, {
        signal,
      })
      this.addEventListener("keydown", this.handleKeyDown, { signal })
      this.addEventListener(
        "focusout",
        (event) => {
          if (!this.contains(event.relatedTarget as Node | null)) this.close()
        },
        { signal },
      )
      document.addEventListener("click", this.handleOutsideClick, { signal })
      this.addEventListener("dropdown-close", () => this.close(), { signal })
      this.addEventListener("dropdown-open", () => this.open(), { signal })
    }

    disconnectedCallback() {
      this.events?.abort()
    }

    private items(): HTMLElement[] {
      return Array.from(
        this.content?.querySelectorAll<HTMLElement>(
          "[data-dropdown-item]:not([disabled]):not([aria-disabled='true'])",
        ) ?? [],
      )
    }

    private handleTriggerClick = (event: Event) => {
      event.preventDefault()
      event.stopPropagation()
      if (this.isOpen) this.close(true)
      else this.open()
    }

    private handleContentClick = (event: Event) => {
      if ((event.target as Element).closest("[data-dropdown-item]"))
        this.close(true)
    }

    private handleOutsideClick = (event: Event) => {
      if (!this.contains(event.target as Node)) this.close()
    }

    private handleKeyDown = (event: KeyboardEvent) => {
      if (event.target === this.trigger) {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault()
          this.open(event.key === "ArrowUp" ? -1 : 0)
        }
      } else if (this.isOpen) {
        const items = this.items()
        const index = items.indexOf(document.activeElement as HTMLElement)
        let next: number | undefined
        if (event.key === "ArrowDown") next = (index + 1) % items.length
        if (event.key === "ArrowUp")
          next = (index - 1 + items.length) % items.length
        if (event.key === "Home") next = 0
        if (event.key === "End") next = items.length - 1
        if (next !== undefined) {
          event.preventDefault()
          items[next]?.focus()
        }
        if (
          event.key === " " &&
          document.activeElement instanceof HTMLAnchorElement
        ) {
          event.preventDefault()
          document.activeElement.click()
        }
      }
      if (this.isOpen && event.key === "Escape") {
        event.preventDefault()
        event.stopPropagation()
        this.close(true)
      }
      if (this.isOpen && event.key === "Tab") this.close(true)
    }

    private open(index = 0) {
      if (!this.content) return
      document
        .querySelectorAll("[data-dropdown-root][data-state='open']")
        .forEach((other) => {
          if (other !== this)
            other.dispatchEvent(new CustomEvent("dropdown-close"))
        })
      this.isOpen = true
      this.dataset.state = "open"
      this.trigger?.setAttribute("aria-expanded", "true")
      this.position()
      this.items().at(index)?.focus()
    }

    private close(restoreFocus = false) {
      this.isOpen = false
      this.dataset.state = "closed"
      this.trigger?.setAttribute("aria-expanded", "false")
      if (restoreFocus) this.trigger?.focus()
    }

    private position() {
      if (!this.trigger || !this.content) return
      const trigger = this.trigger.getBoundingClientRect()
      const content = this.content.getBoundingClientRect()
      const margin = 10
      let left = 0
      if (this.content.dataset.align === "end")
        left = trigger.width - content.width
      if (this.content.dataset.align === "center")
        left = (trigger.width - content.width) / 2
      left = Math.min(
        left,
        window.innerWidth - trigger.left - content.width - margin,
      )
      left = Math.max(left, margin - trigger.left)
      this.content.style.left = `${left}px`
    }
  }

  if (!customElements.get("dropdown-menu")) {
    customElements.define("dropdown-menu", DropdownMenu)
  }
</script>

<style is:global>
  [data-dropdown-root] {
    position: relative;
    display: inline-block;
  }

  [data-dropdown-content] {
    position: absolute;
    display: none;
    inset-block-start: calc(100% + var(--dropdown-offset, 4px));
    inset-inline-start: 0;
    z-index: 50;
    min-inline-size: 10rem;
    max-inline-size: calc(100vw - 1.25rem);
    max-block-size: min(24rem, calc(100dvh - 6rem));
    overflow: auto;
    overscroll-behavior: contain;
    padding-block: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
    color: var(--foreground);
    opacity: 0;
    visibility: hidden;
    scale: 0.98;
    transform-origin: top left;
    transition:
      display var(--motion-duration) var(--motion-ease) allow-discrete,
      opacity var(--motion-duration) var(--motion-ease),
      visibility var(--motion-duration) var(--motion-ease),
      scale var(--motion-duration) var(--motion-ease);
  }

  [data-dropdown-content][data-align="end"] {
    transform-origin: top right;
  }

  [data-dropdown-content][data-align="center"] {
    transform-origin: top center;
  }

  [data-dropdown-root][data-state="open"] [data-dropdown-content] {
    display: block;
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  @starting-style {
    [data-dropdown-root][data-state="open"] [data-dropdown-content] {
      opacity: 0;
      scale: 0.98;
    }
  }

  [data-dropdown-item] {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    inline-size: 100%;
    min-block-size: var(--control-size);
    margin: 0;
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid transparent;
    appearance: none;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    text-align: start;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  [data-dropdown-item]:first-child {
    border-start-start-radius: calc(var(--radius-md) - 1px);
    border-start-end-radius: calc(var(--radius-md) - 1px);
  }

  [data-dropdown-item]:last-child {
    border-end-start-radius: calc(var(--radius-md) - 1px);
    border-end-end-radius: calc(var(--radius-md) - 1px);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-dropdown-item]:hover {
      border-color: color-mix(in oklab, var(--accent) 55%, var(--border));
      background-color: color-mix(in oklab, var(--accent) 24%, transparent);
      color: var(--foreground);
    }
  }

  [data-dropdown-item][aria-current],
  [data-dropdown-item][aria-selected="true"],
  [data-dropdown-item][data-active] {
    background-color: var(--primary);
    color: var(--primary-foreground);
    font-weight: var(--font-weight-medium);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-dropdown-item][aria-current]:hover,
    [data-dropdown-item][aria-selected="true"]:hover,
    [data-dropdown-item][data-active]:hover {
      background-color: color-mix(in oklab, var(--primary) 88%, var(--accent));
      color: var(--primary-foreground);
    }
  }
</style>
