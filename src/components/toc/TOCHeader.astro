---
import type { MarkdownHeading } from "astro"

import Icon from "@/components/base/Icon.astro"
import { getUIStrings } from "@/lib/ui-strings"
import ScrollArea from "@/components/toc/ScrollArea.astro"
import TOCHeadingLink from "@/components/toc/TOCHeadingLink.astro"

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const hasHeadings = headings && headings.length > 0
const ui = getUIStrings(Astro.url.pathname)
---

{hasHeadings && (
    <nav id="mobile-toc-container" class="mobile-toc" aria-label={ui.tableOfContents}>
      <details data-disclosure>
        <summary>
          <toc-progress
            role="progressbar"
            aria-label={ui.readingProgress}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle
                class="toc-progress-track"
                cx="12"
                cy="12"
                r="10"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle
                id="mobile-toc-progress-circle"
                class="toc-progress-value"
                cx="12"
                cy="12"
                r="10"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-dasharray="62.83"
                stroke-dashoffset="62.83"
                transform="rotate(-90 12 12)"
              />
            </svg>
          </toc-progress>
          <toc-current
            id="mobile-toc-current-section"
            data-default-label={ui.overview}
          >
            {ui.overview}
          </toc-current>
          <span data-disclosure-chevron class="mobile-toc-chevron">
            <Icon name="mingcute:down-line" aria-hidden="true" />
          </span>
        </summary>

        <toc-panel data-scroll-container>
          <ScrollArea data-scroll-area>
            <ul id="mobile-toc">
              {headings.map((heading) => (
                <TOCHeadingLink heading={heading} class="toc-heading-link" />
              ))}
            </ul>
          </ScrollArea>
        </toc-panel>
      </details>
    </nav>
  )}

<style>
  .mobile-toc {
    --scroll-area-display: flex;
    --scroll-area-flex-direction: column;
    --scroll-area-max-block-size: 60dvh;

    position: relative;
    inline-size: 100%;
  }

  details {
    overflow-x: hidden;
  }

  summary {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
    inline-size: 100%;
    padding: var(--space-s);
    cursor: pointer;
    list-style: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  toc-progress {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  toc-progress svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  toc-progress circle {
    fill: none;
    stroke-width: 2;
  }

  .toc-progress-track {
    color: color-mix(in oklab, var(--primary) 20%, transparent);
    stroke: currentColor;
  }

  .toc-progress-value {
    color: var(--primary);
    stroke: currentColor;
  }

  toc-current {
    min-inline-size: 0;
    flex: 1;
    overflow: hidden;
    color: var(--foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-tight);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-toc-chevron {
    margin-inline-start: auto;
  }

  /* Floated over the page rather than added to the sticky bar's height, so
     opening the table of contents does not push the article down the screen
     and take the reader's place with it. */
  toc-panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    z-index: 20;
    display: block;
    border: 1px solid var(--border);
    border-start-start-radius: 0;
    border-start-end-radius: 0;
    border-end-start-radius: var(--radius-lg);
    border-end-end-radius: var(--radius-lg);
    background: var(--background);
    box-shadow: 0 0.75rem 2rem -1rem oklch(0 0 0 / 35%);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-s);
    margin: 0;
    list-style: none;
  }
</style>

<script>
  import { SITE } from "@site-config"
  import { UnifiedTOCController } from "@/lib/toc"

  let controller: UnifiedTOCController | null = null

  function closeHeader() {
    const detailsElement = document.querySelector<HTMLDetailsElement>(
      "#mobile-toc-container details",
    )
    if (detailsElement) detailsElement.open = false
  }

  function initController() {
    const container = document.getElementById("mobile-toc-container")
    container?.querySelectorAll("a").forEach((link) => {
      if ((link as HTMLElement).dataset.closeBound === "true") return
      ;(link as HTMLElement).dataset.closeBound = "true"
      link.addEventListener("click", closeHeader)
    })

    controller?.cleanup()
    controller = new UnifiedTOCController(
      "#mobile-toc-container",
      "#mobile-toc-container [data-heading-link]",
      { isMobile: true, tocMaxDepth: SITE.tocMaxDepth },
    )
    controller.init()
  }

  function cleanupController() {
    controller?.cleanup()
    controller = null
  }

  document.addEventListener("astro:page-load", initController)
  document.addEventListener("astro:after-swap", initController)
  document.addEventListener("astro:before-swap", cleanupController)
  document.addEventListener("astro:before-preparation", closeHeader)
  document.addEventListener("astro:before-swap", closeHeader)
</script>
