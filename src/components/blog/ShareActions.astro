---
import { SITE } from "@site-config"
import { getShareActions } from "@/lib/blog/share"
import type { AuthorData } from "@/lib/blog/types"
import CopyButton from "@/components/base/CopyButton.astro"
import { getUIStrings } from "@/lib/ui-strings"
import Icon from "@/components/base/Icon.astro"

interface Props {
  title: string
  url: string
  authors: AuthorData[]
  class?: string
}

const { title, url, authors, class: className } = Astro.props
const ui = getUIStrings(Astro.url.pathname)
const shareActions = getShareActions(
  SITE.blog.shareActions,
  title,
  url,
  authors,
)
---

<div class:list={["share-actions", className]} aria-label={ui.postActions}>
  <CopyButton
    text={url}
    label={ui.copyUrl}
    title={ui.copyPostUrl}
    size="1rem"
    class="share-action"
  />
  {shareActions.map((action) => (
      <a
        href={action.href}
        target="_blank"
        rel="noopener noreferrer"
        class="share-action"
        title={action.label}
      >
        <Icon name={action.icon} size="1rem" />
        <span>{action.label}</span>
      </a>
    ))}
</div>

<style>
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  :global(.share-action) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs);
    border-radius: var(--radius-md);
    color: var(--foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    user-select: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  :global(.share-action:hover) {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  :global(.share-action:active) {
    background: color-mix(in oklab, var(--accent) 80%, transparent);
  }
</style>
