---
import { getStageVariant } from "@/lib/blog/stage"
import { taxonomyPath } from "@/lib/blog/taxonomy"
import { getContentHref, getContentSlug } from "@/lib/content-locale"
import { getSiteLocale } from "@/lib/i18n"
import { getUIStrings } from "@/lib/ui-strings"
import type { PostMeta } from "@/lib/blog/types"
import Badge from "@/components/base/Badge.astro"
import CoverImage from "@/components/base/CoverImage.astro"
import Icon from "@/components/base/Icon.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import Card from "@/components/base/card/Card.astro"
import CardMedia from "@/components/base/card/CardMedia.astro"
import CardContent from "@/components/base/card/CardContent.astro"
import CardDescription from "@/components/base/card/CardDescription.astro"
import CardFooter from "@/components/base/card/CardFooter.astro"
import CardMeta from "@/components/base/card/CardMeta.astro"
import CardTitle from "@/components/base/card/CardTitle.astro"
import PostMetadata from "@/components/blog/PostMetadata.astro"

interface Props {
  metadata: PostMeta
}

const { metadata } = Astro.props
const locale = getSiteLocale(Astro.url.pathname)
const ui = getUIStrings(locale)
const tags = metadata.tags
const hasBadges = metadata.stage || (tags && tags.length > 0)
---

<Card
  href={getContentHref("blog", metadata.id, metadata)}
  label={ui.postLabel(metadata.title)}
  class="preview-card"
  orientation="inline"
>
  <CardMedia class="preview-card-media">
    <CoverImage
      image={metadata.image}
      seed={getContentSlug(metadata.id, metadata)}
      sizes="(max-width: 40rem) 100vw, 14rem"
    />
  </CardMedia>

  <CardContent class="preview-card-content">
    <CardTitle>{metadata.title}</CardTitle>
    <CardDescription>{metadata.description}</CardDescription>
    <CardMeta>
      <PostMetadata {...metadata} variant="card" />
    </CardMeta>
    {hasBadges && (
        <CardFooter class="preview-card-badges">
          {metadata.stage && (
              <Badge
                variant={getStageVariant(metadata.stage)}
                href={taxonomyPath("stage", metadata.stage, locale)}
              >
                <Icon name={metadata.stage} />
                {metadata.stage}
              </Badge>
          )}
          {tags && tags.map((tag: string) => (
              <TaxonomyChip label={tag} static />
            ))}
        </CardFooter>
      )}
  </CardContent>
</Card>

<style>
  .preview-card {
    position: relative;
    align-items: stretch;
    overflow: hidden;
  }

  .preview-card-content {
    position: relative;
    z-index: 1;
    justify-content: center;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  /* A fixed ratio keeps a row of cards aligned whatever shape the source
     image is, and stops a tall photo from setting the card's height. */
  :global(.preview-card-media) {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  :global(.preview-card-media) :global(.cover) {
    transition: transform var(--motion-duration-slow) var(--motion-ease);
  }

  .preview-card:hover :global(.preview-card-media) :global(.cover) {
    transform: scale(1.03);
  }

  .preview-card :global([data-slot="card-title"]) {
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .preview-card:hover :global([data-slot="card-title"]) {
    color: var(--primary);
  }

  .preview-card-badges {
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .preview-card-badges::-webkit-scrollbar {
    display: none;
  }

  @media (width < 40rem) {
    .preview-card {
      flex-direction: column;
    }
  }

  @media (width >= 40rem) {
    :global(.preview-card-media) {
      inline-size: 14rem;
      flex-shrink: 0;
      aspect-ratio: 16 / 11;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-card:hover :global(.preview-card-media) :global(.cover) {
      transform: none;
    }
  }
</style>
