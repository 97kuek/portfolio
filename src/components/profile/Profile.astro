---
import type { ProfileConfig } from "@/types"

import avatarImage from "@/assets/avatar.jpg"

import Avatar from "@/components/base/Avatar.astro"
import Badge from "@/components/base/Badge.astro"
import Icon from "@/components/base/Icon.astro"

import EmailLink from "./EmailLink.astro"
import Pronunciation from "./Pronunciation.astro"
import ProfileLinks from "./ProfileLinks.astro"
import { getDisplayName, getProfileLinkPlacement } from "./helper"
import { Content as AboutContent } from "@/content/about.md"
import { Content as AboutEnglishContent } from "@/content/about-en.md"
import { getSiteLocale } from "@/lib/i18n"
import { getUIStrings } from "@/lib/ui-strings"
import { PROFILE_AVATAR_WIDTH } from "@/lib/layout"

import "@/styles/callout.css"

interface Props {
  profile: ProfileConfig
  continueHref?: string
}

const { profile, continueHref } = Astro.props

const aboutLinks = getProfileLinkPlacement("about")
const locale = getSiteLocale(Astro.url.pathname)
const isEnglish = locale === "en"
const ui = getUIStrings(locale)
const displayName = getDisplayName(locale)
const tagline = isEnglish
  ? profile.tagline
  : profile.taglineJa || profile.tagline
---

<div class="profile-block">
  <article id="profile">
    <header class="profile-header">
      <Avatar
        src={avatarImage}
        alt={displayName}
        fallback={isEnglish ? "KU" : "植"}
        data-slot="profile-avatar"
        width={PROFILE_AVATAR_WIDTH}
        height={PROFILE_AVATAR_WIDTH}
        loading="eager"
        fetchpriority="high"
        class="profile-avatar"
      />

      <div class="profile-content">
        <div class="profile-heading">
          <h1>
            {displayName}
            {profile.pronouns && (
              <Badge variant="outline" class="profile-pronouns">
                {profile.pronouns}
              </Badge>
            )}
          </h1>
          <p class="profile-tagline">{tagline}</p>
        </div>

        <div class="profile-meta">
          {profile.email && <EmailLink email={profile.email} />}

          {profile.phone && (
            <span class="profile-contact-item">
              <Icon name="mingcute:phone-line" />
              <span>{profile.phone}</span>
            </span>
          )}

          {profile.pronunciation && (
            <Pronunciation
              name={profile.name}
              text={profile.pronunciation}
              audio={profile.pronunciationAudioPath}
            />
          )}
        </div>
      </div>
    </header>
  </article>

  <prose-content>
    {isEnglish ? <AboutEnglishContent /> : <AboutContent />}
  </prose-content>

  {aboutLinks.length > 0 && (
      <footer class="profile-footer">
        <ProfileLinks keys={aboutLinks} />
      </footer>
    )}
  {continueHref && (
    <a class="profile-continue" href={continueHref}>
      {ui.viewProjects}
      <Icon name="mingcute:arrow-down-line" aria-hidden="true" />
    </a>
  )}
</div>

<style>
  .profile-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-m);
    min-block-size: calc(100svh - var(--header-height, 3rem) - var(--space-s));
    padding-block-end: var(--space-s);
  }

  .profile-header {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  :global(.profile-avatar) {
    inline-size: clamp(11rem, 29svh, 15rem);
    block-size: auto;
    aspect-ratio: 1;
    max-inline-size: 100%;
    align-self: center;
  }

  .profile-content {
    display: grid;
    min-inline-size: 0;
    max-inline-size: 100%;
    text-align: center;
    gap: var(--space-2xs);
  }

  /* Contact details and the pronunciation trigger share one wrapping row.
     The guide is a tooltip now rather than an inline panel, so nothing in
     this row changes height when it opens and the items can sit centred. */
  .profile-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .profile-heading {
    display: grid;
    gap: var(--space-2xs);
  }

  .profile-heading h1 {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--step-3);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
  }

  .profile-pronouns {
    font-size: var(--step--1);
  }

  .profile-tagline {
    color: var(--foreground);
  }

  .profile-footer {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    padding-inline: var(--space-s);
    color: var(--muted-foreground);
  }

  .profile-contact-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: var(--control-size-compact);
  }

  .profile-contact-item :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .profile-continue {
    display: inline-flex;
    align-self: center;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-block-size: var(--control-size);
    color: var(--foreground);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (width < 40rem) and (height < 40rem) {
    .profile-block {
      gap: var(--space-3xs);
    }

    .profile-header {
      gap: var(--space-3xs);
    }

    :global(.profile-avatar) {
      inline-size: 10rem;
    }

    prose-content {
      line-height: 1.5;
    }
  }

  @media (width >= 40rem) {
    .profile-continue {
      display: none;
    }
    /* Side by side, the name block reads as a caption to the portrait, so it
       sits on the portrait's centre line rather than its top edge. */
    .profile-header {
      flex-direction: row;
      align-items: center;
    }

    .profile-block {
      display: grid;
      min-block-size: auto;
      padding-block-end: 0;
      gap: var(--space-s);
      margin-block-start: var(--space-s);
    }

    .profile-header {
      gap: var(--space-s);
    }

    :global(.profile-avatar) {
      inline-size: 11rem;
      block-size: 11rem;
    }

    .profile-content {
      flex: 1;
      text-align: start;
    }

    .profile-heading h1,
    .profile-meta,
    .profile-footer {
      justify-content: flex-start;
    }
  }
  @media (width >= 40rem) and (height < 30rem) {
    .profile-block {
      gap: var(--space-2xs);
      margin-block-start: var(--space-2xs);
    }

    :global(.profile-avatar) {
      inline-size: 8rem;
      block-size: 8rem;
    }

    .profile-continue {
      display: inline-flex;
      justify-self: center;
    }
  }
</style>
