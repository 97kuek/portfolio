---
import "@/styles/global.css"

import { SITE } from "@site-config"
import BackToTop from "@/components/base/BackToTop.astro"
import Head from "@/components/layout/Head.astro"
import Footer from "@/components/layout/Footer.astro"
import Header from "@/components/layout/Header.astro"
import MenuBar from "@/components/layout/MenuBar.astro"
import Breadcrumbs, {
  type BreadcrumbItem,
} from "@/components/layout/Breadcrumbs.astro"
import { getLocaleTag, getSiteLocale } from "@/lib/i18n"
import { getUIStrings } from "@/lib/ui-strings"

interface Props {
  class?: string
  title?: string
  description?: string
  image?: string | URL
  noindex?: boolean
  type?: "website" | "article" | "profile"
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
  tags?: string[]
  section?: string
  breadcrumbs?: BreadcrumbItem[]
  /** Marks this page's content as the body the search index should read. */
  searchable?: boolean
}

const {
  class: className,
  title,
  description,
  image,
  noindex,
  type,
  publishedTime,
  modifiedTime,
  author,
  tags,
  section,
  breadcrumbs,
  searchable = false,
} = Astro.props
const locale = getSiteLocale(Astro.url.pathname)
const ui = getUIStrings(locale)
---

<!doctype html>
<html
  lang={getLocaleTag(locale)}
  dir={SITE.dir}
  data-zoom-close-label={ui.closeImage}
>
  <Head
    title={title}
    description={description}
    image={image}
    noindex={noindex}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    tags={tags}
    section={section}
  >
    <slot name="head" />
  </Head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
    <MenuBar>
      <Header />
      {Astro.slots.has("subposts-navigation-header") && (
          <slot name="subposts-navigation-header" />
        )}
      {Astro.slots.has("toc-header") && (
          <slot name="toc-header" />
        )}
    </MenuBar>
    {(breadcrumbs || Astro.slots.has("breadcrumb")) && (
        <div class="breadcrumb-region">
          {breadcrumbs ? (
            <Breadcrumbs items={breadcrumbs} />
          ) : (
            <slot name="breadcrumb" />
          )}
        </div>
      )}
    <main
      id="main-content"
      class={className}
      data-pagefind-body={searchable ? "" : undefined}
    >
      <slot />
    </main>
    <BackToTop />
    <Footer />

    <script>
      let headerResizeObserver: ResizeObserver | undefined
      let observedHeader: HTMLElement | null = null

      function updateHeaderHeight() {
        const header = document.getElementById("main-header")
        if (!header) return
        document.documentElement.style.setProperty(
          "--header-height",
          `${header.offsetHeight}px`,
        )
      }

      function observeHeaderHeight() {
        const header = document.getElementById("main-header")
        if (!header) return

        if (header === observedHeader) {
          updateHeaderHeight()
          return
        }

        headerResizeObserver?.disconnect()
        headerResizeObserver = new ResizeObserver(updateHeaderHeight)
        headerResizeObserver.observe(header)
        observedHeader = header
        updateHeaderHeight()
      }

      observeHeaderHeight()
      document.addEventListener("astro:after-swap", observeHeaderHeight)
    </script>
  </body>
</html>

<style>
  body {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    font-family: var(--font-sans);
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    translate: 0 calc(-100% - var(--space-s));
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-md);
    background: var(--foreground);
    color: var(--background);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .skip-link:focus-visible {
    translate: 0;
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .breadcrumb-region {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    min-width: 0;
    margin-block: var(--space-s);
  }

  main {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-m);
    min-width: 0;
  }

  main > :first-child {
    margin-block-start: var(--space-s);
  }
</style>
